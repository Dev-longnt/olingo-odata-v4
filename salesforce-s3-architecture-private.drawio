        <mxCell id="security-features" value="Enhanced Security Features: AWS WAF inside VPC - DDoS Protection, SQL Injection, XSS; API Gateway Private - Rate Limiting, Throttling, API Keys; Lambda Authorizer - Custom JWT/OAuth Authentication; Amazon Cognito - User Pool and Identity Management; Private VPC - Complete Network Isolation; VPC Endpoints - Zero Internet Traffic; Security Groups - Micro-segmentation; CloudWatch - Real-time Monitoring and Alerts" style="text;html=1;strokeColor=#F58536;fillColor=#FFF2CC;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=10;fontStyle=0;fontColor=#232F3E;spacing=5;" parent="1" vertex="1">
          <mxGeometry x="880" y="200" width="300" height="160" as="geometry" />
        </mxCell>
